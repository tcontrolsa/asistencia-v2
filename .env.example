# ==============================================================================
# TCONTROL ASISTENCIA — Plantilla de Variables de Entorno (.env.example)
# Copiar a .env (no versionado). Nunca poner estos valores en variables VITE_*.
# ==============================================================================

VITE_API_URL=http://192.168.10.129:3000

# Administración de la base (scripts de db/). Usuario con permisos de migración.
PGHOST=192.168.10.129
PGPORT=5432
PGDATABASE=tcontrol_asistencia
PGDATABASE_DEV=asistencia_v2_dev
PGUSER=tcontrol
PGPASSWORD=tu_contrasena_aqui

DATABASE_URL=postgresql://tcontrol:tu_contrasena_aqui@192.168.10.129:5432/tcontrol_asistencia

# PostgREST 12 — se conecta como `authenticator` (NO como superusuario) y cambia de rol según el JWT.
# db/scripts/migrate.js fija la contraseña de authenticator con PGRST_AUTHENTICATOR_PASSWORD.
PGRST_AUTHENTICATOR_PASSWORD=genera_una_clave_larga
PGRST_DB_URI=postgresql://authenticator:genera_una_clave_larga@192.168.10.129:5432/asistencia_v2_dev
PGRST_DB_SCHEMAS=api
PGRST_DB_ANON_ROLE=anon
PGRST_SERVER_PORT=3001
PGRST_DB_PRE_REQUEST=private.verificar_sesion
# `node db/scripts/generar-secretos.js` completa en .env PGRST_AUTHENTICATOR_PASSWORD, PGRST_JWT_SECRET y PGRST_DB_URI sin mostrarlos.
# Secreto HS256 de al menos 32 caracteres; el mismo se guarda en private.secretos en la Fase 2.
PGRST_JWT_SECRET=genera_un_secreto_de_32_o_mas_caracteres
